# Copy to .env (never commit .env). Both server/ and worker/ read ../.env

# --- Providers (defaults are MOCKS; live calls only when set explicitly) ---
PROVIDER=fake                 # fake | cloudflare
GUARDRAIL=mock                # mock | gemini
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_MODEL=@cf/black-forest-labs/flux-2-klein-4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # used only on transient errors of the primary (503/429/5xx/timeout); free tier

# --- Free-only quota guard (estimated neurons/day reserved by the app; CF free = 10,000) ---
DAILY_NEURON_BUDGET=5000

# --- Infra (local docker-compose; dev-only credentials) ---
MONGO_URL=mongodb://127.0.0.1:27018/sketch2ring
REDIS_URL=redis://127.0.0.1:6380
AMQP_URL=amqp://guest:guest@127.0.0.1:5672
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret123
S3_BUCKET=sketch2ring

# --- Server ---
PORT=3001
COOKIE_SECRET=change-me-to-a-long-random-string
GEN_WIDTH=1024
GEN_HEIGHT=1024
VARIATIONS=6                  # 1-6; use 1 for a small first live check
DEBUG_UI=1                    # dev-only "behind the scenes" view (/api/debug/*); disabled when NODE_ENV=production
